    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "npx ctx7*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "reviewer": "allow",
