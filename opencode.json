      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://dev.litellm.yellowmind.ai",
        "apiKey": "sk-3996237592156101257"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7"
        },
        "gpt-5.4-medium-oc": {
