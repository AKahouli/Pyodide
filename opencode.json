        "glm-5-turbo": {
          "name": "glm-5-turbo"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "obsidian-mcp-server@2.0.7"
      ],
      "environment": {
        "OBSIDIAN_API_KEY": "3f636a13992a2758e2d08803dbf0546f0a178a049c1c8e0f0bd4ea0c98d8e22d",
        "OBSIDIAN_BASE_URL": "http://127.0.0.1:27123",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_CACHE": "true"
      },
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "chrome-devtools": "allow",
      "ai-elements": "allow",
      "obsidian-context": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "npm *": "allow",
          "pnpm *": "allow",
          "pip *": "allow",
          "poetry *": "allow",
          "npx *": "allow",
          "git push*": "ask",
          "git reset*": "ask",
          "git rebase*": "ask",
          "del *": "ask",
          "rm *": "ask",
          "ls *": "allow",
          "pytest *": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "plan": "allow",
          "reviewer": "allow",
          "diagnostics": "allow",
          "frontend-qa": "allow",
          "maintainer": "allow"
        }
