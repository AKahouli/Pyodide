{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowmind.dev/contracts/observability/log-event.v1.schema.json",
  "title": "Yellowmind log event v1",
  "description": "One versioned JSON envelope for every owned application event. Local JSON-lines format aligned with OTel concepts; not an OTLP wire payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "event_id",
    "event_name",
    "message",
    "severity_text",
    "severity_number",
    "service_name",
    "service_version",
    "environment",
    "event_origin",
    "attributes"
  ],
  "allOf": [
    { "if": { "properties": { "severity_text": { "const": "TRACE" } } }, "then": { "properties": { "severity_number": { "const": 1 } } } },
    { "if": { "properties": { "severity_text": { "const": "DEBUG" } } }, "then": { "properties": { "severity_number": { "const": 5 } } } },
    { "if": { "properties": { "severity_text": { "const": "INFO" } } }, "then": { "properties": { "severity_number": { "const": 9 } } } },
    { "if": { "properties": { "severity_text": { "const": "WARN" } } }, "then": { "properties": { "severity_number": { "const": 13 } } } },
    { "if": { "properties": { "severity_text": { "const": "ERROR" } } }, "then": { "properties": { "severity_number": { "const": 17 } } } },
    { "if": { "properties": { "severity_text": { "const": "FATAL" } } }, "then": { "properties": { "severity_number": { "const": 21 } } } }
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "timestamp": {
      "type": "string",
      "description": "UTC RFC 3339 occurrence time, milliseconds or greater precision. Never replaced by collection time.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3,9})?Z$"
    },
    "event_id": {
      "type": "string",
      "description": "Unique per emission; unchanged by collectors/retries. Boot id + monotonic sequence is acceptable.",
      "minLength": 1,
      "maxLength": 128
    },
    "event_name": {
      "type": "string",
      "description": "Stable registry name; no interpolation or free text.",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "description": "Static default message from the registry for owned events; bounded sanitized text for adapters.",
      "maxLength": 1024
    },
    "severity_text": { "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"] },
    "severity_number": {
      "description": "OTel base values. Mapping to severity_text enforced by conformance tests.",
      "enum": [1, 5, 9, 13, 17, 21]
    },
    "service_name": {
      "type": "string",
      "description": "Stable registry name from deployment/bootstrap; never per-call user data.",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "service_version": {
      "type": "string",
      "description": "Deployed code revision/build identifier.",
      "minLength": 1,
      "maxLength": 64
    },
    "environment": {
      "type": "string",
      "description": "Controlled deployment vocabulary.",
      "minLength": 1,
      "maxLength": 32
    },
    "event_origin": { "enum": ["application", "framework", "infrastructure", "logger"] },
    "service_instance_id": { "type": "string", "maxLength": 128 },
    "trace_id": {
      "type": "string",
      "description": "Valid active OTel/W3C trace id; all-zero placeholders forbidden.",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "span_id": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" },
    "trace_flags": { "type": "integer", "minimum": 0, "maximum": 255 },
    "request_id": { "type": "string", "maxLength": 128 },
    "user_id": { "type": "string", "maxLength": 128 },
    "username": { "type": "string", "maxLength": 128 },
    "actor_type": { "enum": ["user", "service", "system"] },
    "workspace_id": { "type": "string", "maxLength": 128 },
    "conversation_id": { "type": "string", "maxLength": 128 },
    "run_id": { "type": "string", "maxLength": 128 },
    "job_id": { "type": "string", "maxLength": 128 },
    "agent_id": { "type": "string", "maxLength": 128 },
    "error": { "$ref": "#/$defs/error" },
    "attributes": {
      "type": "object",
      "description": "Event-approved primitive fields and small primitive arrays. No nested objects.",
      "maxProperties": 32,
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
      "additionalProperties": { "$ref": "#/$defs/attrValue" }
    },
    "truncated_fields": {
      "type": "array",
      "description": "Bounded list of field names that were truncated or discarded. Never raw discarded content.",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 64 }
    },
    "observed_timestamp": {
      "type": "string",
      "description": "Collector-added collection time, separate from occurrence time.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3,9})?Z$"
    }
  },
  "$defs": {
    "attrValue": {
      "anyOf": [
        { "type": "string", "maxLength": 512 },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "number" },
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "anyOf": [
              { "type": "string", "maxLength": 512 },
              { "type": "boolean" },
              { "type": "integer" },
              { "type": "number" }
            ]
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1024 },
        "stack": { "type": "string", "maxLength": 3072 },
        "retryable": { "type": "boolean" },
        "cause": { "$ref": "#/$defs/errorCause" }
      }
    },
    "errorCause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1024 },
        "cause": { "$ref": "#/$defs/errorCauseLeaf" }
      }
    },
    "errorCauseLeaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
