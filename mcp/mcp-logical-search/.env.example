# MCP logical search configuration. Timeouts are seconds unless stated otherwise.
# Keep real credentials in .env; .env.example contains deployment placeholders.

# MCP server binding and authentication. HOST/PORT optionally override MCP_HOST/MCP_PORT.
MCP_HOST=0.0.0.0
MCP_PORT=8045
MCP_API_KEY=replace-with-a-service-secret
# The trusted backend supplies dynamic workspace scope through Workspace-Id.
# The gateway connects to this loopback-published address by default.
MCP_BIND_ADDRESS=127.0.0.1
HEALTH_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
# Probes require both this network policy and MCP_API_KEY authentication.
HEALTH_READY_CACHE_SECONDS=5
HTTP_BODY_MAX_BYTES=1048576
HTTP_SCOPE_MAX_CHARS=1024
HTTP_SUMMARY_MAX_PAIRS=100
HTTP_REQUESTS_PER_MINUTE=120
HTTP_MODEL_REQUESTS_PER_MINUTE=10
ROUTING_PROFILE_MAX_SECTIONS=200
ROUTING_PROFILE_TIMEOUT_SECONDS=120
# Optional binding overrides (leave commented to use MCP_HOST/MCP_PORT):
# HOST=0.0.0.0
# PORT=8045

# PostgreSQL connection, pool capacity, admission queues and query timeouts (milliseconds for DB_STATEMENT_TIMEOUT_MS).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SYNC_WORKER_LIMIT=10
DB_QUEUE_LIMIT=100
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false
# Remote PostgreSQL requires certificate and hostname verification on both drivers.
# disable is accepted only for a local loopback database (development/isolated CI).
DB_TLS_MODE=verify-full
# Both service database drivers also enforce read-only transactions.
# DB_TLS_CA_FILE=/path/to/database-ca.pem

# Console logging format and Uvicorn logging configuration.
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
COLOR_LOGS=true
LOG_CONFIG_PATH=./src/logger/uvicorn_disable_logging.json

# Optional request/query file logs: directory, sampling, payload size, queue and rotation limits.
REQUEST_LOG_DIR=logs
REQUEST_LOG_ENABLED=False
REQUEST_LOG_MAX_CHARS=20000
REQUEST_LOG_SAMPLE_RATE=0.05
REQUEST_LOG_QUEUE_SIZE=1000
REQUEST_LOG_MAX_BYTES=10000000
REQUEST_LOG_BACKUP_COUNT=3

# Local fastText language model; provision this artifact before server startup.
LANGUAGE_MODEL_PATH=models/lid.176.bin

# LiteLLM gateway connection for chat and embedding models.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Approve the exact scheme/host/port of the gateway above, without /v1.
MODEL_ALLOWED_ORIGINS=[]
# Development only: permits an explicitly approved HTTP loopback model server.
MODEL_ALLOW_HTTP_LOOPBACK=false

# Embedding model, vector dimension and batching. Dimension must match the ingested database vectors.
OPENAI_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSION=2048
# Enable only when ingestion uses the same Matryoshka prefix reduction.
EMBEDDING_MATRYOSHKA=False
OPENAI_CHUNK_SIZE=1000
EMBEDDING_TIMEOUT_SECONDS=15

# Shared model admission limits and provider retry policy; embedding requests disable provider retries.
MODEL_REQUEST_LIMIT=10
MODEL_QUEUE_LIMIT=100
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_MIN_SECONDS=2
OPENAI_RETRY_MAX_SECONDS=20

# Model used to generate document summaries.
RESUME_MODEL=gpt-5.4-mini

# Query translation: false skips detection/translation. Timeout values are seconds; reasoning effort is provider-specific.
QUERY_TRANSLATION_ENABLED=true
QUERY_TRANSLATION_MODEL=gpt-5.6-luna
QUERY_TRANSLATION_REASONING_EFFORT=low
QUERY_TRANSLATION_TIMEOUT_SECONDS=5

# Search deadlines in seconds and SQL scope filtering. false restores legacy discovery.
SEARCH_REQUEST_TIMEOUT_SECONDS=30
SEARCH_RETRIEVAL_RESERVE_SECONDS=5
SEARCH_SCALABLE_SCOPE_ENABLED=true

# Hybrid retrieval ranking. Block/section/filename weights must sum to 1.
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=0.8
HYBRID_BM25_WEIGHT=1.0
SEARCH_BLOCK_WEIGHT=0.75
SEARCH_SECTION_WEIGHT=0.20
SEARCH_FILENAME_WEIGHT=0.05
SEARCH_MIN_SCORE=0.3

# Optional filename semantic scoring: bounded file candidates and model timeout in seconds.
SEARCH_FILENAME_SEMANTIC_ENABLED=true
SEARCH_FILENAME_SEMANTIC_TIMEOUT_SECONDS=5
SEARCH_FILENAME_SEMANTIC_MAX_FILES=100

# Document discovery score thresholds, candidate/result budgets and per-document match limits.
SEARCH_DOCUMENTS_MIN_VECTOR_SCORE=0.5
SEARCH_DOCUMENTS_MIN_SCORE=0.35
SEARCH_DOCUMENTS_RELATIVE_SCORE=0.7
SEARCH_DOCUMENTS_LEXICAL_BONUS=0.08
SEARCH_DOCUMENTS_CANDIDATE_LIMIT=100
SEARCH_DOCUMENTS_RESULT_LIMIT=10
SEARCH_DOCUMENTS_MATCHES_PER_DOCUMENT=3
SEARCH_COVERAGE_DOCUMENT_LIMIT=10
SEARCH_BEST_MATCHES_PER_DOCUMENT=3

# Search response size: result count, preview/evidence characters, UTF-8 evidence bytes and section/block limits.
SEARCH_RESULT_LIMIT_MAX=100
SEARCH_PREVIEW_MAX_CHARS=200
SEARCH_EVIDENCE_MAX_CHARS=1000
SEARCH_EVIDENCE_MAX_BYTES=24000
SEARCH_SECTION_BLOCK_LIMIT=3
SECTION_SEARCH_MAX_SECTIONS=10

# Input limits for query characters, collection items and batch items.
REQUEST_QUERY_MAX_CHARS=4000
REQUEST_COLLECTION_MAX_ITEMS=100
REQUEST_BATCH_MAX_ITEMS=10

# Document readers: navigation page threshold, batch bytes, deadline seconds and pagination sizes.
PAGE_THRESHOLD=20
READ_CONTENT_BATCH_MAX_BYTES=500000
READ_REQUEST_TIMEOUT_SECONDS=30
READ_BLOCK_PAGE_SIZE=1000
READ_IMAGE_PAGE_SIZE=20

# Context expansion limits and whether responses include image bytes.
EXPAND_CONTEXT_DESCENDANT_LIMIT=20
EXPAND_CONTEXT_SAME_LEVEL_LIMIT=10
EXPAND_CONTEXT_INCLUDE_IMAGE_BYTES=false

# Coordinate conversion DPI for image and Mistral bounding boxes.
IMAGE_BBOX_DPI=144
IMAGE_MAX_ENCODED_BYTES=20000000
IMAGE_MAX_DECODED_BYTES=15000000
IMAGE_MAX_PIXELS=25000000
MISTRAL_BBOX_DPI=87

# Shutdown grace period in seconds for admitted operations to finish.
SHUTDOWN_GRACE_SECONDS=30
