# Server Configuration
TEAMS_MCP_TRANSPORT=sse
TEAMS_MCP_PORT=8003
ALLOWED_ORIGINS=*
HOST=0.0.0.0
MCP_AUTH_MODE=JWT
MCP_INGRESS_TOKEN=
MCP_JWT_PUBLIC_KEY=/run/secrets/mcp-jwt-public.pem
MCP_JWT_ISSUER=yellowstorm
MCP_JWT_AUDIENCE=mcp-team
M365_ACCESS_TOKEN=
# Logging
LOG_LEVEL=info

# Optional: Proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
