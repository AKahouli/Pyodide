# Sandbox manager (required)
SANDBOX_MANAGER_URL=http://sandbox.yellowsys.org
SANDBOX_MANAGER_TOKEN=your-token-here

# JSON array of workspace names to mount (empty array = mount all)
SANDBOX_WORKSPACE_PATHS=[]

# Dev mode: point directly at a fixed VM, skip the manager
# SANDBOX_ADDRESS=192.168.1.100

# Sandbox TTL in minutes before idle cleanup
SANDBOX_TTL_MINUTES=30

# Acquisition resilience (optional overrides)
# SANDBOX_ACQUIRE_MAX_ATTEMPTS=3
# SANDBOX_PROBE_MAX_ATTEMPTS=3
# SANDBOX_PROBE_INTERVAL_MS=200
# SANDBOX_EXECUTABLE_MAX_ATTEMPTS=15
# SANDBOX_EXECUTABLE_INTERVAL_SEC=2.0
# SANDBOX_READY_FAIL_ON_TIMEOUT=true
# SANDBOX_USE_LEASE_LOOKUP=true

# HTTP transport
MCP_HOST=0.0.0.0
MCP_PORT=8001

# Inbound auth: backend must send `Authorization: Bearer <this>`.
# Required for every deployment. Never expose the port without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-to-a-long-random-string

# Logging
LOG_LEVEL=INFO
