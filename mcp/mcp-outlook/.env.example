# Server Configuration
OUTLOOK_MCP_TRANSPORT=streamable-http
OUTLOOK_MCP_PORT=8002
ALLOWED_ORIGINS=*
HOST=0.0.0.0
MCP_AUTH_MODE=JWT
MCP_INGRESS_TOKEN=
MCP_JWT_PUBLIC_KEY=/run/secrets/mcp-jwt-public.pem
MCP_JWT_ISSUER=yellowstorm
MCP_JWT_AUDIENCE=mcp-outlook
# Header carrying the acting user's delegated Microsoft Graph token, resolved per
# request by the connector auth layer (ADR-0017 provider authority, ADR-0026).
# There is no environment token: an ambient tenant credential would let a caller
# inherit tenant authority. Missing/invalid user tokens fail closed.
M365_TOKEN_HEADER=x-m365-access-token
# Logging
LOG_LEVEL=info

# Optional: Proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# Ceph S3 storage — required for `storage_key` attachments (large generated
# files are read from here, uploaded to OneDrive, and shared with recipients).
CEPH_S3_ENDPOINT=https://s3.example.org
CEPH_S3_REGION=us-east-1
CEPH_S3_BUCKET=yellowstorm
CEPH_S3_ACCESS_KEY_ID=
CEPH_S3_SECRET_ACCESS_KEY=
CEPH_S3_FORCE_PATH_STYLE=true

# Attachment routing (optional)
# Files at or under this size are attached; larger ones go to OneDrive + share.
MAIL_ATTACH_MAX_BYTES=26214400
MAIL_ATTACH_ONEDRIVE_FOLDER=Email Attachments
