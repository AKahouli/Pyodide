YELLOWSTORM_BACKEND_URL=http://localhost:3000
PLAYBOOK_MCP_BACKEND_SERVICE_TOKEN=replace-with-distinct-secret-manager-value
PLAYBOOK_MCP_INGRESS_TOKEN=replace-with-secret-manager-value
PLAYBOOK_MCP_AUTH_MODE=Bearer
# JWT mode: mount the signing key's public PEM in this container.
PLAYBOOK_MCP_JWT_PUBLIC_KEY_FILE=
PLAYBOOK_MCP_JWT_ISSUER=
PLAYBOOK_MCP_JWT_AUDIENCE=mcp-playbook
PLAYBOOK_MCP_TIMEOUT_SECONDS=190
PLAYBOOK_MCP_MAX_RESPONSE_BYTES=2097152
PLAYBOOK_MCP_SEARCH_LIMIT_MAX=25
MCP_PORT=8025
