# Server Configuration
SHAREPOINT_MCP_TRANSPORT=sse
PORT=8001
ALLOWED_ORIGINS=*
HOST=0.0.0.0
MCP_AUTH_MODE=JWT
MCP_INGRESS_TOKEN=
MCP_JWT_PUBLIC_KEY=/run/secrets/mcp-jwt-public.pem
MCP_JWT_ISSUER=yellowstorm
MCP_JWT_AUDIENCE=mcp-sharepoint
M365_ACCESS_TOKEN=
# Logging
LOG_LEVEL=info

# Optional: Proxy settings
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# Ceph/S3 storage — required by download_documents. Must be the same bucket the
# sandbox manager serves at /home/manus/ceph-workspaces, or downloaded files are
# invisible to the code interpreter. See RUN_STORAGE_CONTRACT.md (mcp-outlook).
CEPH_S3_ENDPOINT=
CEPH_S3_REGION=us-east-1
CEPH_S3_BUCKET=
CEPH_S3_ACCESS_KEY_ID=
CEPH_S3_SECRET_ACCESS_KEY=
CEPH_S3_FORCE_PATH_STYLE=true

# Caps on one download_documents call (a recursive folder walk is otherwise unbounded)
MAX_DOWNLOAD_FILES=200
MAX_DOWNLOAD_BYTES=536870912
