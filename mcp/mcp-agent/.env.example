YELLOWSTORM_BACKEND_URL=http://localhost:3000
AGENT_MCP_AUTH_MODE=JWT
# JWT mode: mount the signing key's public PEM in this container.
AGENT_MCP_JWT_PUBLIC_KEY_FILE=
AGENT_MCP_JWT_ISSUER=
AGENT_MCP_JWT_AUDIENCE=mcp-agent
AGENT_MCP_TIMEOUT_SECONDS=60
AGENT_MCP_MAX_RESPONSE_BYTES=2097152
AGENT_MCP_LIST_LIMIT_MAX=25
MCP_PORT=8026
