YELLOWSTORM_BACKEND_URL=http://localhost:3000
MCP_JWT_PUBLIC_KEY_FILE=
MCP_JWT_ISSUER=yellowstorm
MCP_JWT_AUDIENCE=mcp-pyodide
PYODIDE_MCP_TIMEOUT_SECONDS=100
MCP_PORT=8027
PYODIDE_MCP_MAX_CODE_BYTES=65536
PYODIDE_MCP_MAX_INPUT_BYTES=2097152
PYODIDE_MCP_MAX_RESULT_BYTES=524288
PYODIDE_MCP_MAX_LOG_BYTES=262144
PYODIDE_MCP_MAX_QUEUE=3

# --- Manus sandbox (tools sandbox_*/shell_exec/file_*/send_file_to_user) ---
# Manager boundary (production profile). The token is a secret: never commit it.
SANDBOX_MANAGER_URL=http://sandbox.yellowsys.org
SANDBOX_MANAGER_TOKEN=
# Dev mode only: point directly at a fixed VM and skip the manager.
# SANDBOX_ADDRESS=192.168.1.100
SANDBOX_TTL_MINUTES=30
SANDBOX_PUBLISH_TIMEOUT_SECONDS=120
