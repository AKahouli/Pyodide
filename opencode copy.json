{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://142.132.131.111:3014"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7"
        },
        "gpt-5.4-medium-oc": {
          "name": "GPT-5.4 Medium OC "
        },
        "gpt-5.4": {
          "name": "GPT-5.4 OC "
        },
        "gpt-5.4-low-oc": {
          "name": "GPT-5.4 Low OC"
        },
        "gpt-5.4-mini-oc": {
          "name": "GPT-5.4 Mini OC"
        },
        "gpt-5.4-nano-oc": {
          "name": "GPT-5.4 Nano OC"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "chrome-devtools": "allow",
      "ai-elements": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "npm run test*": "allow",
          "npm run build*": "allow",
          "npm run lint*": "allow",
          "pnpm run test*": "allow",
          "pnpm run build*": "allow",
          "pnpm run lint*": "allow",
          "poetry run pytest*": "allow",
          "git push*": "ask",
          "git reset*": "ask",
          "git rebase*": "ask",
          "del *": "ask",
          "rm *": "ask",
          "docker compose down*": "allow",
          "kubectl *": "allow"
        },
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "backend-architect": "allow",
          "frontend-ui-ux-designer": "allow",
          "browser-qa-engineer": "allow",
          "code-reviewer": "allow",
          "test-engineer": "allow",
          "security-auditor": "allow",
          "performance-engineer": "allow",
          "debugger-root-cause": "allow",
          "ai-systems-engineer": "allow",
          "refactoring-maintainer": "allow",
          "docs-maintainer": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "browser-qa-engineer": "allow",
          "code-reviewer": "allow",
          "security-auditor": "allow",
          "performance-engineer": "allow",
          "debugger-root-cause": "allow",
          "docs-maintainer": "allow"
        }
      }
    }
  }
}