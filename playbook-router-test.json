{ "name": "Quality Review Loop", "nodes": [ { "id": "writer", "kind": "step", "label": "Write Article", "output": { "ports": [{ "id": "article", "label": "Article", "type": "text" }] } }, { "id": "reviewer", "kind": "step", "label": "Score Quality", "output": { "ports": [{ "id": "score", "label": "Score", "type": "number" }] } }, { "id": "gate", "kind": "router", "label": "Quality Gate", "routerConfig": { "outputLabels": ["retry", "done"], "maxIterations": 3, "defaultLabel": "retry", "conditions": [ { "label": "done", "sourceNode": "reviewer", "sourcePort": "score", "operator": "gte", "value": 8 } ] } }, { "id": "finalizer", "kind": "step", "label": "Finalize", "output": { "ports": [{ "id": "result", "label": "Result", "type": "text" }] } } ], "controlEdges": [ { "id": "e1", "kind": "sequential", "source": "writer", "target": "reviewer" }, { "id": "e2", "kind": "sequential", "source": "reviewer", "target": "gate" }, { "id": "e3", "kind": "conditional", "source": "gate", "target": "writer", "routerLabel": "retry" }, { "id": "e4", "kind": "conditional", "source": "gate", "target": "finalizer", "routerLabel": "done" } ] }