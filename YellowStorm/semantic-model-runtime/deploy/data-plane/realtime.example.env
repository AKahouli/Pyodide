# Realtime-only secrets (copy to realtime.env, fill from secret storage, never commit).
REALTIME_DB_PASSWORD=<control-db-postgres-password>
REALTIME_DB_ENC_KEY=<exactly-16-chars-aes-128-key>
REALTIME_API_JWT_SECRET=<management-api-hs256-secret>
REALTIME_SECRET_KEY_BASE=<64-hex-chars>
REALTIME_TENANT_JWT_SECRET=<tenant-hs256-secret>
