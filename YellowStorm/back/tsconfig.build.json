{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // nest-cli deleteOutDir wipes dist/; incremental emit then skips JS and leaves dist/main missing.
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "scripts",
    "**/*spec.ts",
    "src/modules/app-data/templates/sources/**",
    "drizzle.config.ts"
  ]
}