{
  "name": "yellostorm-backend",
  "version": "1.11.1",
  "description": "YelloStorm AI Agent Chat Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "postbuild": "node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); fs.copyFileSync('package.json','dist/package.json');\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:contracts": "jest --config ./test/jest-contracts.json",
    "load:playbook-flow": "node scripts/playbook-flow-load-gate.mjs",
    "semantic-model:migrate": "node scripts/semantic-model/migrate.mjs",
    "semantic-model:verify": "node scripts/semantic-model/verify.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "backfill:agents": "ts-node scripts/backfill-agents-to-postgres.ts",
    "backfill:usage": "ts-node scripts/backfill-usage-to-postgres.ts",
    "test:migration:conversations": "ts-node scripts/test-conversation-postgres-migration.ts",
    "test:store:conversations": "ts-node -r tsconfig-paths/register scripts/test-conversation-postgres-store.ts",
    "repair:conversation-owner-members": "ts-node scripts/migrations/2026-09-18-repair-conversation-owner-members.ts",
    "backfill:humain-embeddings": "ts-node scripts/backfill-humain-role-embeddings.ts",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@azure/msal-node": "^3.8.5",
    "@electric-sql/client": "^1.5.23",
    "@google/genai": "^2.16.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@types/pg": "^8.20.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "adm-zip": "^0.5.17",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "16.4.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.0",
    "js-yaml": "^4.1.1",
    "markdown-it": "^15.0.1",
    "mongoose": "^8.21.0",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "ua-parser-js": "^2.0.8"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.29.1",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "commit-and-tag-version": "^12.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 2,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  },
  "overrides": {
    "multer": "2.1.0",
    "lodash": "4.17.23",
    "serialize-javascript": "7.0.4",
    "tmp": "0.2.5",
    "glob": "11.1.0",
    "webpack": "5.105.3",
    "fast-xml-parser": "5.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
