{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.proto",
      "**/*.pem",
      "**/*.crt",
      "**/*.cert",
      { "include": "modules/app-data/templates/assets/**/*", "outDir": "dist/src" },
      { "include": "modules/conversation-v2/templates/assets/**/*", "outDir": "dist/src" }
    ],
    "watchAssets": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
