{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
"assets": [
      "**/*.proto",
      "**/*.pem",
      "**/*.crt",
      "**/*.cert",
      "**/*.html",
      "**/*.png",
      "**/*.svg",
      { "include": "../scripts/**/*.sql", "outDir": "dist" }
    ],
    "watchAssets": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
