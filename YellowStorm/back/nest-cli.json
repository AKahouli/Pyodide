{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.proto",
        "outDir": "dist/src"
      },
      "**/*.pem",
      "**/*.crt",
      "**/*.cert",
      {
        "include": "modules/app-data/templates/assets/**/*",
        "outDir": "dist"
      },
      {
        "include": "modules/app-data/templates/sources/**/*",
        "outDir": "dist"
      },
      {
        "include": "modules/app-builder/templates/assets/**/*",
        "outDir": "dist"
      },
      "**/*.html",
      "**/*.png",
      "**/*.svg",
      {
        "include": "../scripts/**/*.sql",
        "outDir": "dist"
      }
    ],
    "watchAssets": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
