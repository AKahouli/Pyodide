venv/
venv.bak/
venvt/
exp_venv/

__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
.mypy_cache/
.ruff_cache/

tests/
docs/
tmp/
scripts/

.env
.env.*
*.log
importtime.log
tmp_check_*.py
docker-compose.yaml

.git/
.gitignore
.dockerignore
Dockerfile
