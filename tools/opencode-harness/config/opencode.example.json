{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": 60000,
    "keep": {
      "tokens": 20000
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-luna": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-luna-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-sol": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-sol-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra-ultrafast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol-ultrafast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1",
          "--isolated",
          "--page-id-routing"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git push*", "effect": "ask" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
        { "action": "shell", "resource": "git rebase*", "effect": "ask" },
        { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
        { "action": "shell", "resource": "del *", "effect": "ask" },
        { "action": "shell", "resource": "rm *", "effect": "ask" },
        { "action": "shell", "resource": "Remove-Item*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "plan", "effect": "allow" },
        { "action": "subagent", "resource": "diagnostics", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-qa", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "maintainer", "effect": "allow" },
        { "action": "subagent", "resource": "worker", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "impeccable", "effect": "allow" },
        { "action": "skill", "resource": "frontend-design", "effect": "allow" },
        { "action": "skill", "resource": "context7-mcp", "effect": "allow" },
        { "action": "skill", "resource": "archify", "effect": "allow" },
        { "action": "skill", "resource": "find-skills", "effect": "allow" },
        { "action": "skill", "resource": "graphify-navigation", "effect": "allow" },
        { "action": "skill", "resource": "ponytail", "effect": "allow" },
        { "action": "chrome-devtools_*", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "experimental": { "subagent_depth": 1 }
}
