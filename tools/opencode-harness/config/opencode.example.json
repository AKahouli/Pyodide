{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "code-review-graph==2.3.9",
        "code-review-graph",
        "serve"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--page-id-routing"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git rebase*": "ask",
          "git checkout -- *": "ask",
          "del *": "ask",
          "rm *": "ask",
          "Remove-Item*": "ask"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "plan": "allow",
          "diagnostics": "allow",
          "frontend-qa": "allow",
          "reviewer": "allow",
          "maintainer": "allow",
          "worker": "allow"
        },
        "skill": {
          "*": "deny",
          "impeccable": "allow",
          "frontend-design": "allow",
          "context7-mcp": "allow",
          "archify": "allow",
          "find-skills": "allow",
          "crg-navigation": "allow"
        },
        "chrome-devtools_*": "deny"
      }
    }
  },
  "subagent_depth": 1
}
