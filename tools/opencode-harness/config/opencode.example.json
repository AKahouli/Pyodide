{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 60000,
    "preserve_recent_tokens": 20000
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6-luna": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-luna-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-sol": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-sol-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6-astra-ultrafast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol-fast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } },
        "gpt-6.1-sol-ultrafast": { "limit": { "context": 1050000, "input": 460000, "output": 128000 } }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--page-id-routing"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git rebase*": "ask",
          "git checkout -- *": "ask",
          "del *": "ask",
          "rm *": "ask",
          "Remove-Item*": "ask"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "plan": "allow",
          "diagnostics": "allow",
          "frontend-qa": "allow",
          "reviewer": "allow",
          "maintainer": "allow",
          "worker": "allow"
        },
        "skill": {
          "*": "deny",
          "impeccable": "allow",
          "frontend-design": "allow",
          "context7-mcp": "allow",
          "archify": "allow",
          "find-skills": "allow",
          "graphify-navigation": "allow",
          "ponytail": "allow"
        },
        "chrome-devtools_*": "deny"
      }
    }
  },
  "subagent_depth": 1
}
